+#ifdef RAWGL_MEMFS
+/* RAWGL_MEMFS: every file is served by whoever links the engine (a Chimera
+ * core has its files mounted by name and no directories), by the path the
+ * engine asks for ("<datapath>/<name>"), matched as the host sees fit (case,
+ * folders): out of memory (rawgl_memfs_find), or, for a file too large to
+ * copy (a disc image), read in place by position (rawgl_memfs_host_read), so
+ * that nothing of the host - no open handle, no file position - is part of
+ * the engine's state between two calls. Nothing is ever written. */
+extern "C" const uint8_t *rawgl_memfs_find(const char *path, uint32_t *size);
+extern "C" int rawgl_memfs_host(const char *path, uint32_t *size);
+extern "C" uint32_t rawgl_memfs_host_read(int id, uint32_t pos, void *ptr, uint32_t len);
+
+struct memFile : File_impl {
+	const uint8_t *_data;
+	int _host;
+	uint32_t _size, _pos;
+	memFile() : _data(0), _host(-1), _size(0), _pos(0) {}
+	bool open(const char *path, const char *mode) {
+		_ioErr = false;
+		_data = 0;
+		_host = -1;
+		_size = _pos = 0;
+		if (mode[0] != 'r') {
+			return false;
+		}
+		_data = rawgl_memfs_find(path, &_size);
+		if (!_data) {
+			_host = rawgl_memfs_host(path, &_size);
+		}
+		return (_data != 0 || _host >= 0);
+	}
+	bool isOpen() const {
+		return _data != 0 || _host >= 0;
+	}
+	void close() {
+		_data = 0;
+		_host = -1;
+		_size = _pos = 0;
+	}
+	uint32_t size() {
+		return isOpen() ? _size : 0;
+	}
+	void seek(int off, int whence) {
+		if (isOpen()) {
+			long pos = (whence == SEEK_CUR) ? (long)_pos + off : (whence == SEEK_END) ? (long)_size + off : off;
+			_pos = (pos < 0) ? 0 : (pos > (long)_size) ? _size : (uint32_t)pos;
+		}
+	}
+	int read(void *ptr, uint32_t len) {
+		if (isOpen()) {
+			uint32_t r = (len > _size - _pos) ? _size - _pos : len;
+			if (_data) {
+				memcpy(ptr, _data + _pos, r);
+			} else {
+				r = rawgl_memfs_host_read(_host, _pos, ptr, r);
+			}
+			_pos += r;
+			if (r != len) {
+				/* what a read past the end leaves is zeros, not what the
+				 * caller's buffer held before (File::readByte's is not
+				 * initialised, and the 3DO's song player reads 8 bytes past
+				 * each song at every loop) */
+				memset((uint8_t *)ptr + r, 0, len - r);
+				_ioErr = true;
+			}
+			return r;
+		}
+		memset(ptr, 0, len);
+		return 0;
+	}
+	int write(void *ptr, uint32_t len) {
+		_ioErr = true;
+		return 0;
+	}
+};
+#endif
+
 File::File() {
+#ifdef RAWGL_MEMFS
+	_impl = new memFile;
+#else
 	_impl = new stdFile;
+#endif
 }
 
