{
  "coreName": "rawgl",
  "kind": "game",
  "systemId": "AnotherWorld",
  "author": "Delphine Software / Eric Chahi (1991); rawgl by Gregory Montoir (cyx); chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-rawgl",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's 1 MiB of game memory and its picture pages on the heap; the game's files, unpacked from the project's zip, in sealed memory (Another World's largest release is under 2 MiB); the engine's own stack (1 MiB) and the zip while it is read, mmap'd.",
  "memoryLayoutMiB": [
    32,
    16,
    4,
    4,
    32
  ],
  "video": {
    "_comment": "The game's 320x200 screen, drawn by rawgl's software renderer as the 1991 original drew it (Graphics::_is1991), shown on a 4:3 monitor.",
    "width": 320,
    "height": 200,
    "virtualWidth": 320,
    "virtualHeight": 240,
    "vsyncNumerator": 25,
    "vsyncDenominator": 2,
    "_vsync_note": "A frame is one step of the game (docs/game-cores.md): one frame the game shows, held for as many fiftieths of a second as its script says (VAR_PAUSE_SLICES) - most of the game 4, 12.5 Hz; the pause, each 50 ms it waits for P. GetVsyncNumerator/Denominator report the step just run (1000/milliseconds); 25/2 is four fiftieths.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The engine's four sound channels and its music module player (rawgl's mixer, as its SDL build plays them), at 44100 Hz for exactly the time each step covers. The music tells the script where it is (VAR_MUSIC_SYNC), so it is part of the machine: it plays by the machine's time, never the host's.",
    "rate": 44100,
    "samplesPerFrame": 44200,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Another World",
    "_comment": "The game's controls as rawgl reads them: the joystick (the arrows; Up is jump, Down crouch) and its fire button (run, shoot, charge the gun; Space or Enter), then the keyboard's commands - Code (C, to the password screen, where a release has one) and Pause (P, not on the copy protection or the intro) - and the letters and Backspace, which only the password screen reads. A button pressed is a key typed once. Left out: rawgl's screenshot and fast-mode keys, which are the frontend's business, and its 3DO-only keys.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Action",
      "Code",
      "Pause",
      "Key A",
      "Key B",
      "Key C",
      "Key D",
      "Key E",
      "Key F",
      "Key G",
      "Key H",
      "Key I",
      "Key J",
      "Key K",
      "Key L",
      "Key M",
      "Key N",
      "Key O",
      "Key P",
      "Key Q",
      "Key R",
      "Key S",
      "Key T",
      "Key U",
      "Key V",
      "Key W",
      "Key X",
      "Key Y",
      "Key Z",
      "Key Backspace"
    ]
  },
  "settings": [
    {
      "name": "language",
      "display": "Language",
      "type": "enum",
      "options": [
        "us",
        "fr",
        "de",
        "es",
        "it"
      ],
      "default": "us",
      "description": "rawgl's language (its --language): the texts the DOS, Amiga and Atari ST releases show come from rawgl's tables, French for fr and English for the others, and the DOS release's title screen is \"Another World\" in French, \"Out of This World\" otherwise. Changes what the game draws, so a movie records it."
    },
    {
      "name": "randomSeed",
      "display": "Random seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 65535,
      "description": "What the script's random seed variable (0x3C) starts at - rawgl takes it from the clock (time()); the game's own random numbers grow from it. A movie records the number it ran with."
    }
  ]
}
