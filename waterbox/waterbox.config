  "settings": [
    {
      "name": "release",
      "display": "Release",
      "type": "enum",
      "options": [
        "dos",
        "amiga",
        "amigafr",
        "atari",
        "win31",
        "3do",
        "15th",
        "20th",
        "dosdemo",
        "stdemo"
      ],
      "default": "dos",
      "description": "Which release of Another World this project plays (it is the System in Chimera). \"dos\" is Another World (DOS). \"amiga\" is Another World (Amiga, English). \"amigafr\" is Another World (Amiga, French). \"atari\" is Another World (Atari ST). \"win31\" is Out of This World (Windows 3.1). \"3do\" is Out of This World (3DO). \"15th\" is the 15th Anniversary Edition. \"20th\" is the 20th Anniversary Edition. \"dosdemo\" is the Out of This World DOS demo. \"stdemo\" is the Atari ST rolling demo. The release decides which of the game's files the project needs (as firmware) and which settings apply. rawgl plays the files as it finds them."
    },
    {
      "name": "language",
      "display": "Language",
      "type": "enum",
      "options": [
        "us",
        "fr",
        "de",
        "es",
        "it"
      ],
      "default": "us",
      "description": "The language rawgl uses (its --language option). It selects the game's texts. For the DOS, Amiga and Atari ST releases these are rawgl's own tables (French for 'fr', English otherwise). The anniversary editions and the Windows 3.1 release use their own text files. It also selects the DOS release's title screen, which says \"Another World\" in French and \"Out of This World\" otherwise. It changes what the game draws, so a movie records it.",
      "when": [
        "dos",
        "amiga",
        "amigafr",
        "atari",
        "15th",
        "20th",
        "dosdemo",
        "stdemo"
      ]
    },
    {
      "name": "randomSeed",
      "display": "Random seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 65535,
      "description": "The starting value of the game script's random seed (script variable 0x3C). rawgl normally takes it from the clock, and the game's random numbers follow from it. The 20th Anniversary Edition also uses it to choose between sound variants. A movie records the number it ran with."
    },
    {
      "name": "difficulty",
      "display": "Difficulty (20th Anniversary)",
      "type": "enum",
      "options": [
        "easy",
        "normal",
        "hard"
      ],
      "default": "normal",
      "description": "The difficulty of the 20th Anniversary Edition (rawgl's --difficulty option). The game's script reads it (variable 0xBF). The other releases have no difficulty setting.",
      "when": [
        "20th"
      ]
    },
    {
      "name": "remasteredAudio",
      "display": "Remastered Sound (Anniversary Editions)",
      "type": "bool",
      "default": true,
      "description": "Chooses between the remastered sounds and music of the anniversary editions (rawgl's default, --audio=remastered) and the original ones. The originals are the 15th's Data files and Music/AW, and the 20th's game/WGZ/original and game/OGG/original. The 20th's script also reads this choice (variable 0xDE). The other releases have only one set of sounds.",
      "when": [
        "15th",
        "20th"
      ]
    },
    {
      "name": "mt32",
      "display": "MT-32 Sound Effects (DOS)",
      "type": "bool",
      "default": false,
      "description": "Plays the DOS release's sound effects on a Roland CM-32L (rawgl's --mt32 option). rawgl has a note for 41 of the effects and sends those to the CM-32L's rhythm part, in place of the game's own samples. The CM-32L is emulated by Munt with the ROMs the project supplies as firmware (CM32L_CONTROL.ROM and CM32L_PCM.ROM). The music stays the game's own. It changes the sound only. The other releases ignore it.",
      "when": [
        "dos",
        "dosdemo"
      ]
    },
    {
      "name": "soundFont",
      "display": "SoundFont Music (Windows 3.1)",
      "type": "bool",
      "default": false,
      "description": "Plays the Windows 3.1 release's music. The music is two General MIDI files, which the original played on the PC's MIDI synthesizer. Here TinySoundFont plays them with a General MIDI SoundFont that the project supplies as firmware (soundfont.sf2, any .sf2 file of your choice, and the project records which one). With this off the music is silent, as in rawgl without a MIDI synthesizer. It changes the sound only. The game and its timing are the same either way. The other releases ignore it.",
      "when": [
        "win31"
      ]
    }
  ],
  "firmware": [
    {
      "id": "dos-disk",
      "display": "Another World DOS disk",
      "description": "The floppy disk image of the DOS release (.img or .ima), or a zip of the files on it (MEMLIST.BIN and the BANK files). The copy that was checked is GoodOldDays' Out of This World, one 1.2 MB disk. You have to supply it, because this package includes none of the game's files. A file of your own can be used in its place, and the project then records its hash.",
