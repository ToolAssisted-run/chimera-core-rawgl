{
  "coreName": "rawgl",
  "kind": "game",
  "systemId": "AnotherWorld",
  "author": "Delphine Software / Eric Chahi (1991); rawgl by Gregory Montoir (cyx); chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-rawgl",
  "deterministic": true,
  "_memory_note": "[sbrk, sealed, invisible, plain, mmap] MiB: the engine's 1 MiB of game memory and its picture pages on the heap; the game's files, unpacked from the project's zip, in sealed memory - the anniversary editions' data and a SoundFont's samples (as floats, twice the file) are the large ones; a 3DO disc image is read in place and takes none; the engine's own stack (1 MiB), the decoders' buffers and a SoundFont while it loads, mmap'd. To be sized to the real releases' data once they are measured.",
  "memoryLayoutMiB": [
    64,
    1024,
    4,
    4,
    512
  ],
  "video": {
    "_comment": "The game's 320x200 screen, drawn by rawgl's software renderer - as the 1991 original drew it for the DOS, Amiga, Atari ST and Windows 3.1 releases and the anniversary editions (whose HD pictures are rawgl's OpenGL renderer's and are not drawn), in 15-bit colour for the 3DO - shown on a 4:3 monitor. The 3DO's and Windows 3.1's full-screen pictures (logos, title, the pause) are shown at their own size, up to 640x480: the live size comes from GetVideoWidth/Height.",
    "width": 640,
    "height": 480,
    "virtualWidth": 320,
    "virtualHeight": 240,
    "vsyncNumerator": 25,
    "vsyncDenominator": 2,
    "_vsync_note": "A frame is one step of the game (docs/game-cores.md): one frame the game shows, held for as many fiftieths of a second as its script says (VAR_PAUSE_SLICES; most of the game 4, 12.5 Hz), sixtieths on the 3DO; the pause, each 50 ms it waits for P. GetVsyncNumerator/Denominator report the step just run (1000/milliseconds); 25/2 is four fiftieths.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "The game's sound as rawgl's SDL build plays it, at 44100 Hz for exactly the time each step covers: the engine's own channels and module player (DOS, Amiga, Atari ST), whose music tells the script where it is (VAR_MUSIC_SYNC) and so plays by the machine's time; the anniversary editions' and Windows 3.1's WAV sounds with their music (a WAV, an Ogg Vorbis, a MIDI file played with the project's SoundFont); the 3DO's AIFF sounds and SDX2 songs.",
    "rate": 44100,
    "samplesPerFrame": 44200,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "input": {
    "name": "Another World",
    "_comment": "The game's controls as rawgl reads them: the joystick (the arrows; Up jumps, Down crouches - on the 3DO, Jump jumps) and its fire button (run, shoot, charge the gun; Space or Enter), then the keyboard's commands - Code (C, to the password screen, where a release has one), Pause (P, not on the copy protection or the intro) and, on the 3DO, Back (its end menu) - and the letters and Backspace, which only the password screen reads. A button pressed is a key going down, a button let go a key coming up, as rawgl's SDL frontend sees them: where the game takes a press (a menu, a picture it waits on), a button still held is not pressed again until it is let go. Jump and Back are the 3DO's only (IsButtonActive). Left out: rawgl's screenshot and fast-mode keys, which are the frontend's business.",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Action",
      "P1 Jump",
      "Code",
      "Pause",
      "Back",
      "Key A",
      "Key B",
      "Key C",
      "Key D",
      "Key E",
      "Key F",
      "Key G",
      "Key H",
      "Key I",
      "Key J",
      "Key K",
      "Key L",
      "Key M",
      "Key N",
      "Key O",
      "Key P",
      "Key Q",
      "Key R",
      "Key S",
      "Key T",
      "Key U",
      "Key V",
      "Key W",
      "Key X",
      "Key Y",
      "Key Z",
      "Key Backspace"
    ]
  },
  "settings": [
    {
      "name": "language",
      "display": "Language",
      "type": "enum",
      "options": [
        "us",
        "fr",
        "de",
        "es",
        "it"
      ],
      "default": "us",
      "description": "rawgl's language (its --language): the texts - rawgl's tables for the DOS, Amiga and Atari ST releases (French for fr, English otherwise), the anniversary editions' own text files, Windows 3.1's strings - and the DOS release's title screen, \"Another World\" in French and \"Out of This World\" otherwise. Changes what the game draws, so a movie records it."
    },
    {
      "name": "randomSeed",
      "display": "Random seed",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 65535,
      "description": "What the script's random seed variable (0x3C) starts at - rawgl takes it from the clock (time()); the game's own random numbers grow from it. The 20th Anniversary Edition also seeds its choice among sound variants with it. A movie records the number it ran with."
    },
    {
      "name": "difficulty",
      "display": "Difficulty (20th Anniversary)",
      "type": "enum",
      "options": [
        "easy",
        "normal",
        "hard"
      ],
      "default": "normal",
      "description": "The 20th Anniversary Edition's difficulty (rawgl's --difficulty), which its script reads (variable 0xBF). The other releases have none."
    },
    {
      "name": "remasteredAudio",
      "display": "Remastered Sound (Anniversary Editions)",
      "type": "bool",
      "default": true,
      "description": "The anniversary editions' remastered sounds and music (rawgl's --audio=remastered, its default), or the original ones (the 15th's Data files and Music/AW, the 20th's game/WGZ/original and game/OGG/original). The 20th's script reads it too (variable 0xDE). The other releases have one sound."
    },
    {
      "name": "mt32",
      "display": "MT-32 Sound Effects (DOS)",
      "type": "bool",
      "default": false,
      "description": "The DOS release's sound effects on a Roland CM-32L (rawgl's --mt32): rawgl sends the effects it has a note for (41 of them, Mixer::_mt32SoundsTable) to the CM-32L's rhythm part instead of playing the game's own samples, and the CM-32L is Munt's emulation, with the ROMs the project brings (firmware CM32L_CONTROL.ROM and CM32L_PCM.ROM). The music stays the game's own. Changes the sound only. The other releases ignore it."
    }
  ],
  "firmware": [
    {
      "id": "CM32L_CONTROL.ROM",
      "display": "Roland CM-32L control ROM",
      "description": "CM32L_CONTROL.ROM: no file of the game's: the Roland CM-32L's control ROM, v1.02, for the MT-32 sound effects (the mt32 setting). Yours to supply - the package carries none of it. Another control ROM Munt knows (the CM-32L's v1.00, an MT-32's) may take its place, the project pinning its hash; an MT-32 lacks the CM-32L's extra effect sounds some of rawgl's notes are for.",
      "size": 65536,
      "sha1": "A439FBB390DA38CADA95A7CBB1D6CA199CD66EF8",
      "name": "CM32L_CONTROL.ROM",
      "requiredWhen": {
        "setting": "mt32",
        "is": true
      }
    },
    {
      "id": "CM32L_PCM.ROM",
      "display": "Roland CM-32L PCM ROM",
      "description": "CM32L_PCM.ROM: no file of the game's: the Roland CM-32L's PCM ROM (1 MB), for the MT-32 sound effects (the mt32 setting). Yours to supply - the package carries none of it. Another PCM ROM Munt knows may take its place, the project pinning its hash.",
      "size": 1048576,
      "sha1": "289CC298AD532B702461BFC738009D9EBE8025EA",
      "name": "CM32L_PCM.ROM",
      "requiredWhen": {
        "setting": "mt32",
        "is": true
      }
    }
  ]
}
