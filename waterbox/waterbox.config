      "when": [
        "20th"
      ]
    },
    {
      "name": "remasteredAudio",
      "display": "setting.remasteredaudio",
      "type": "bool",
      "default": true,
      "description": "setting.remasteredaudio.about",
      "when": [
        "15th",
