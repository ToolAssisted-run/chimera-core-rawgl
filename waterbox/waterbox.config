      }
    },
    {
      "id": "atari-demo-disk",
      "display": "Another World Atari ST rolling demo disk",
      "description": "Cover disk 28 of the magazine ST Action (issue 44, December 1991), which holds the rolling demo AW.TOS. It can be the disk image (.st or .stx) or a zip of AW.TOS. You have to supply it, because this package includes none of the game's files. A file of your own can be used in its place, and the project then records its hash.",
      "sha1": "03706F52AF59404E30278B2772FDDA5C4CD4743B",
      "name": "STActionIssue44_STAction_Disk28of58_AtariST_Dump1.st",
      "requiredWhen": {
        "setting": "release",
        "is": "stdemo"
      }
    },
    {
      "id": "CM32L_CONTROL.ROM",
      "display": "Roland CM-32L control ROM",
      "description": "CM32L_CONTROL.ROM is not one of the game's files. It is the control ROM of the Roland CM-32L, version 1.02, used for the MT-32 Sound Effects setting. You have to supply it, because this package includes none of it. Another control ROM that Munt knows (the CM-32L's version 1.00, or an MT-32's) can be used in its place, and the project then records its hash. An MT-32 does not have the CM-32L's extra effect sounds, which some of rawgl's notes use.",
      "size": 65536,
      "sha1": "A439FBB390DA38CADA95A7CBB1D6CA199CD66EF8",
      "name": "CM32L_CONTROL.ROM",
      "requiredWhen": {
        "all": [
          {
            "setting": "mt32",
            "is": true
          },
          {
            "setting": "release",
            "in": [
              "dos",
              "dosdemo"
            ]
          }
        ]
      }
    },
    {
