      "Key J": "j",
      "Key K": "k",
      "Key L": "l",
      "Key M": "m",
      "Key N": "n",
      "Key O": "o",
      "Key P": "p",
      "Key Q": "q",
      "Key R": "r",
      "Key S": "s",
      "Key T": "t",
      "Key U": "u",
      "Key V": "v",
      "Key W": "w",
      "Key X": "x",
      "Key Y": "y",
      "Key Z": "z",
      "Key Backspace": "B"
    }
  },
  "settings": [
    {
      "name": "release",
      "display": "setting.release",
      "type": "enum",
      "options": [
        "dos",
        "amiga",
        "amigafr",
        "atari",
        "win31",
        "3do",
        "15th",
        "20th",
        "dosdemo",
        "stdemo"
      ],
      "default": "dos",
      "description": "setting.release.about"
    },
    {
      "name": "language",
      "display": "setting.language",
      "type": "enum",
      "options": [
        "us",
        "fr",
        "de",
        "es",
        "it"
      ],
      "default": "us",
      "description": "setting.language.about",
